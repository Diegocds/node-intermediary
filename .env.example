# Copie para .env e ajuste: cp .env.example .env
# O .env NÃO vai para o git (ver .gitignore); este arquivo sim, como modelo.

# Porta HTTP da API
PORT=3008

# Opção 1: string de conexão única (tem prioridade sobre as PG* abaixo)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/node_intermediary

# Opção 2: variáveis padrão do driver pg
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=node_intermediary

# Ajustes do pool (opcionais; valores abaixo são os padrões do db/pool.js)
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# Banco SÓ para os testes de integração (npm test). A tabela users é apagada
# a cada execução. Sem esta variável, esses testes são pulados.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/node_intermediary_test
